# Kopiér til .env og tilpas.
# Port og adresse på værten. 127.0.0.1 = kun nginx på samme maskine kan nå appen.
SUPERVISION_PORT=9473
SUPERVISION_BIND=127.0.0.1
SUPERVISION_SESSION_HOURS=12
SUPERVISION_IDLE_MINUTES=60
SUPERVISION_MAX_FILE_MB=15
SUPERVISION_QUOTA_MB=250
# Subnet til det interne compose-netværk (skift hvis det overlapper et eksisterende netværk)
SUPERVISION_SUBNET=10.203.64.0/28
